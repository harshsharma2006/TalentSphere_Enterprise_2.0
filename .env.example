# ==========================================
# TalentSphere Enterprise 2.0 Environment Configuration
# ==========================================

# Environment Mode: development | staging | production
APP_ENV=development
APP_NAME="TalentSphere Enterprise 2.0"
APP_VERSION=2.0.0
DEBUG=True

# Database Configuration
# SQLite local default (relative to project root)
DATABASE_URL=sqlite:///./talentsphere_enterprise.db
# PostgreSQL production example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/talentsphere_db

# Security
SECRET_KEY=change-this-to-a-cryptographically-secure-random-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_BCRYPT_ROUNDS=12

# Super Admin Initial Provisioning (used only on first startup if no admin exists)
INITIAL_ADMIN_EMAIL=superadmin@talentsphere.local
INITIAL_ADMIN_USERNAME=superadmin
INITIAL_ADMIN_PASSWORD=SuperAdmin@2026

# Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8501

# AI Engine Settings
AI_PROVIDER=local_fallback
# Optional external LLM API keys:
GEMINI_API_KEY=
OPENAI_API_KEY=

# File Upload Limits (in Megabytes)
MAX_UPLOAD_SIZE_MB=25

# Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
